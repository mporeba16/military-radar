# OpenSky Network jest używane wyłącznie jako anonimowy fallback po adsb.fi.
# Nie wymaga konta — OpenSky wycofał Basic auth (OPENSKY_USER/PASS nie dawały
# już wyższego limitu), więc te zmienne zostały usunięte. Wyższy limit
# wymagałby dziś OAuth2 (client credentials), niepotrzebny dla rzadkiego fallbacku.

# VAPID keys do Web Push (wygeneruj: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:twoj@email.com

# Dostępne w frontendzie (prefix VITE_)
VITE_VAPID_PUBLIC_KEY=
